# Copiez ce fichier en .env et renseignez vos valeurs. Ne commitez jamais .env.

# --- Base de données (PostgreSQL) ---------------------------------------------
# Développement local (docker compose up -d) :
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ecommerce
# Production (Supabase, Neon…) : URL du pooler pour l'application, URL directe pour les migrations.
# DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Stripe (mode TEST en développement) --------------------------------------
# Clé SECRÈTE : Dashboard → Développeurs → Clés API → « Clé secrète » (commence par sk_test_).
# Ce n'est PAS la clé publiable (pk_test_) : Stripe refuse celle-ci pour les appels serveur.
STRIPE_SECRET_KEY=sk_test_...
# Secret de signature des webhooks. En local : affiché par `stripe listen` (whsec_...).
# En production : Dashboard → Développeurs → Webhooks → votre endpoint → « Secret de signature ».
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Application ---------------------------------------------------------------
# URL publique du site (retours de paiement Stripe, connexion OAuth). Sans slash final.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Adresse d'assistance affichée dans le pied de page (optionnel ; masquée si vide).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Protège /api/cron/reconcile-orders (chaîne aléatoire longue). Vercel Cron l'envoie en Bearer.
CRON_SECRET=

# --- Comptes clients : connexion Google et/ou GitHub (optionnel) --------------
# Sans ces variables, le site fonctionne en paiement invité uniquement (pas de bouton « Sign in »).
# Un fournisseur n'est actif que si son ID ET son secret sont renseignés. Ces variables doivent aussi
# être disponibles au moment du build.
# Secret de session (32 caractères minimum), ex. : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google : console.cloud.google.com → API et services → Identifiants → ID client OAuth (application Web)
#   URI de redirection autorisée : {NEXT_PUBLIC_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub : github.com → Settings → Developer settings → OAuth Apps
#   Authorization callback URL : {NEXT_PUBLIC_BASE_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Livraison (optionnel) -----------------------------------------------------
# Pays livrés (codes ISO, séparés par des virgules). Active la collecte de l'adresse et des frais de livraison.
# SHIPPING_COUNTRIES=CA,US
# Frais forfaitaires, en unité mineure de la devise (999 = 9,99 $). Défaut : 999.
# SHIPPING_FLAT_CENTS=999
# Livraison offerte à partir de ce sous-total (même unité). Non défini = jamais offerte.
# FREE_SHIPPING_OVER_CENTS=10000

# --- Taxes (optionnel) ---------------------------------------------------------
# Calcul automatique par Stripe Tax. À activer d'abord dans le Dashboard Stripe (Paramètres → Tax),
# sinon la création de session Checkout échoue.
# STRIPE_AUTOMATIC_TAX=true
